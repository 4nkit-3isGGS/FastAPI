      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mumbai Tiffin delivery service need to track orders as they move\nthorugh stages -- from kitchen preparation to final delivery.\nThe kitchen staff updates the status at each endpoint.",
      "autoResize": true,
      "lineHeight": 1.25
    },
