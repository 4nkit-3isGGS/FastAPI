      "link": null,
      "locked": false,
      "text": "Rangmanch - a Pune based theatre booking startup, needs \na review API so audience can rate and review play. The \nAPI powers their app's review section and average rating \nplay.     ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rangmanch - a Pune based theatre booking startup, needs \na review API so audience can rate and review play. The \nAPI powers their app's review section and average rating \nplay.     ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
